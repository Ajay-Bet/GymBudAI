# Copy to backend/.env (gitignored) and fill in locally. Never commit the real key.
# Leave OPENAI_API_KEY empty to disable AI voice and AI wording (the app then works fully locally).
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
OPENAI_TEXT_MODEL=gpt-4.1-mini

# Database (Sprint 5). SQLAlchemy URL with the psycopg 3 driver. Local development uses the
# Homebrew/Compose PostgreSQL role `gymbud` with no password; never commit a real password.
# Cloud SQL (proposed, not provisioned): postgresql+psycopg://USER:PASSWORD@/DBNAME?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=postgresql+psycopg://gymbud@127.0.0.1:5432/gymbud_dev
# Used only by pytest; the test suite drops and recreates this database's public schema.
TEST_DATABASE_URL=postgresql+psycopg://gymbud@127.0.0.1:5432/gymbud_test
# Per-process pool: at most DB_POOL_SIZE + DB_MAX_OVERFLOW connections. Statement timeout is 10 s.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT_S=10

# Account sessions: bearer tokens expire this many hours after sign-in (no sliding renewal).
AUTH_SESSION_TTL_HOURS=168

# Comma-separated browser origins allowed to call the API directly. Empty = none
# (local development goes through the Vite proxy).
CORS_ORIGINS=
